CONTEXT7_API_KEY=
# Database connection string (local Docker Compose Postgres default)
# DATABASE_URL="postgres://postgres:postgres@localhost:5432/jobscan"
DATABASE_URL=
# better-auth configuration
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Upstash Redis Configuration (Provisioned via Vercel Marketplace)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# AI Provider Selection
# Options: "claude" | "gemini" | "openai"
AI_PROVIDER="gemini"

# AI API Keys
# Claude (Anthropic API Key) - Default Provider
ANTHROPIC_API_KEY=
# Google Gemini API Key & Model Configuration
GEMINI_API_KEY=
# Default Gemini Model (defaults to "gemini-3.8-flash")
GEMINI_MODEL="gemini-3.8-flash"

# OpenAI API Key
OPENAI_API_KEY=

# Inngest Background Jobs Configuration
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

RESEND_API_KEY=

# DRC Job Crawler Configuration
CRAWL_SECRET=
RELIEFWEB_APP_NAME="jobpilot"

NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

ADMIN_USER_IDS=

# Payment Provider Configuration
# Options: "mock" | "saspay"
PAYMENT_PROVIDER="mock"
ALLOW_MOCK_PAYMENTS="true"

# SasPay Configuration
# API key starting with sk_test_ (sandbox) or sk_live_ (production)
SASPAY_API_KEY=
# Webhook signing secret copied from SasPay dashboard
SASPAY_WEBHOOK_SECRET=
# Base API URL (defaults to https://api.saspay.me/api/v1)
SASPAY_BASE_URL="https://api.saspay.me/api/v1"
