CONTEXT7_API_KEY=
# Database connection string (local Docker Compose Postgres default)
# DATABASE_URL="postgres://benny:bennymak@localhost:5432/jobscan"
DATABASE_URL=
# better-auth configuration
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Redis Cache Configuration (Redis Cloud / Upstash via Vercel Marketplace or local Docker)
# Local: redis://localhost:6379
# Production (Redis Cloud or Upstash): rediss://default:<password>@<host>:<port>
REDIS_URL=
REDIS_MAXMEMORY_POLICY="allkeys-lru"

# AI Provider Selection
# Options: "claude" | "gemini" | "openai"
AI_PROVIDER="gemini"

# AI API Keys
# Claude (Anthropic API Key) - Default Provider
ANTHROPIC_API_KEY=
# Google Gemini API Key
GEMINI_API_KEY=

# OpenAI API Key
OPENAI_API_KEY="

# Inngest Background Jobs Configuration
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

RESEND_API_KEY=

# DRC Job Crawler Configuration
CRAWL_SECRET=
RELIEFWEB_APP_NAME="jobpilot"

NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com